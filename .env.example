# In VIVERSE Studio, open the World App and copy its App ID.
VITE_VIVERSE_CLIENT_ID=

# Leaderboard API names configured in VIVERSE Studio under the same App ID (case-sensitive).
# Defaults below already match what's set up in Studio — only override if you rename them there.
# - Cleared-time board: Numerical, Ascending, keep-best-per-player
# - Survival-time board: Numerical, Descending, keep-best-per-player
# - Deathmatch-score board: Numerical, Descending, keep-best-per-player
VITE_VIVERSE_LEADERBOARD_CLEARED=clearedtime
VITE_VIVERSE_LEADERBOARD_SURVIVAL=survivaltime
VITE_VIVERSE_LEADERBOARD_DEATHMATCH=deathmatchscore
